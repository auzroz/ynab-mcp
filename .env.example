# YNAB MCP Server Configuration

# Required: Your YNAB Personal Access Token
# Get one from: https://app.ynab.com/settings/developer
YNAB_ACCESS_TOKEN=your_personal_access_token_here

# Optional: Default budget ID (UUID)
# If not set, uses "last-used" (your most recently accessed budget)
# YNAB_BUDGET_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info

# Optional: Cache TTL in milliseconds (default: 300000 = 5 minutes)
CACHE_TTL_MS=300000

# Optional: Rate limit per hour (default: 180, max: 200)
# Using 180 as default provides a 10% safety margin
RATE_LIMIT_PER_HOUR=180

# Optional: longest a request waits for a rate-limit token, in ms (default: 2000,
# range 0-60000). 0 = never wait: when the budget is used up, tools return
# rate_limited with retry_after_seconds at once. Applies to stdio and HTTP.
RATE_LIMIT_MAX_WAIT_MS=2000

# Optional: Read-only mode (default: true)
# When true, all write operations (create, update, delete) are blocked
# Set to false to enable write operations
YNAB_READ_ONLY=true

# ---------------------------------------------------------------------------
# Remote / HTTP mode
# ---------------------------------------------------------------------------
# Transport: "stdio" (default, local) or "http" (remote, per-session isolation).
# MCP_TRANSPORT=stdio

# AUTH_MODE is REQUIRED in http mode: "oauth" (multi-user) or "header".
# AUTH_MODE=oauth

# Address to listen on (default: all interfaces). Header mode with YNAB_ACCESS_TOKEN
# refuses a non-loopback bind unless MCP_ALLOW_ANONYMOUS_FALLBACK=true.
# MCP_BIND_HOST=127.0.0.1
# MCP_ALLOW_ANONYMOUS_FALLBACK=false

# HTTP port (http mode only; default 3000)
# PORT=3000

# Public base URL of the deployment (required for OAuth mode below)
# PUBLIC_URL=https://ynab-mcp.example.com

# DNS-rebinding protection (http mode). Requires ALLOWED_HOSTS/ALLOWED_ORIGINS.
# ENABLE_DNS_REBINDING_PROTECTION=true
# ALLOWED_HOSTS=ynab-mcp.example.com
# ALLOWED_ORIGINS=https://claude.ai

# Number of reverse-proxy hops to trust for X-Forwarded-* headers (rate limiting,
# audit logging). Default 0 = trust none, safe for a directly-exposed instance.
# Set to the hop count when running behind a known reverse proxy/ingress
# (e.g. 1 behind a single Traefik/Caddy/nginx in front of the app).
# TRUST_PROXY=1

# Take the client address from Cloudflare's CF-Connecting-IP header (default false).
# Only when the server is reachable solely through Cloudflare; see docs/REMOTE_HOSTING.md.
# TRUST_CF_CONNECTING_IP=true

# /register limits per hour: per client address (default 100) and per redirect URI host (default 20).
# REGISTER_RATE_LIMIT_PER_IP=100
# REGISTER_RATE_LIMIT_PER_HOST=20

# INTERIM (header) AUTH (AUTH_MODE=header): http mode takes the YNAB token per request via the `X-YNAB-Token` header (falling back to
# YNAB_ACCESS_TOKEN above for single-user HTTP). Serve behind TLS.

# ---------------------------------------------------------------------------
# Multi-user YNAB OAuth (http mode) — set ALL of the following to enable it.
# Register your own YNAB OAuth app at https://app.ynab.com/settings/developer
# and set its redirect URI to  <PUBLIC_URL>/oauth/ynab/callback
# ---------------------------------------------------------------------------
# YNAB_OAUTH_CLIENT_ID=your_ynab_oauth_client_id
# YNAB_OAUTH_CLIENT_SECRET=your_ynab_oauth_client_secret
# ENCRYPTION_KEY=base64-encoded-32-byte-key   # openssl rand -base64 32
# Optional pepper for the hashed tokens, codes and state (0.5.0+); without it one
# is derived from ENCRYPTION_KEY. Set it BEFORE the first 0.5.0 start if you want
# one: changing it (or ENCRYPTION_KEY without it) later refuses to start.
# TOKEN_PEPPER=base64-encoded-32-byte-key     # openssl rand -base64 32
# PUBLIC_URL=https://ynab-mcp.example.com
# YNAB_OAUTH_ALLOW_WRITE=false                # allow writes (default false; enforced on every request)

# Storage for users + encrypted tokens (oauth mode): memory (default, non-durable),
# sqlite, or postgres.
# STORAGE_DRIVER=sqlite
# SQLITE_PATH=/data/ynab-mcp.db
# DATABASE_URL=postgres://user:pass@host:5432/ynab_mcp

# Token lifetimes (optional)
# MCP_ACCESS_TOKEN_TTL_SEC=3600
# MCP_AUTH_CODE_TTL_SEC=600
