{
  "name": "ynab-mcp",
  "version": "0.3.4",
  "description": "MCP server providing comprehensive YNAB API coverage for Claude integration",
  "mcpName": "io.github.auzroz/ynab-mcp",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ynab-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ynab",
    "budget",
    "finance",
    "claude",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/auzroz/ynab-mcp.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "decimal.js": "^10.4.3",
    "express": "^5.3.0",
    "ynab": "~4.5.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
